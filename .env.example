# Root Environment Variables for local Docker Compose development
# Do not commit real production passwords or keys to git.

# ----------------- Database config -----------------
POSTGRES_DB=astra_db
POSTGRES_USER=astra_user
POSTGRES_PASSWORD=astra_pass
DATABASE_URL=postgresql+asyncpg://astra_user:astra_pass@postgres:5432/astra_db
DATABASE_URL_SYNC=postgresql://astra_user:astra_pass@postgres:5432/astra_db

# ----------------- Redis config --------------------
REDIS_URL=redis://redis:6379

# ----------------- Backend App config --------------
APP_NAME=ASTRA
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=development
JWT_SECRET_KEY=astra-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY=3600

# ----------------- Data Pipeline config ------------
# Add NASA API Key if fetching real DONKI data
NASA_API_KEY=DEMO_KEY

# ----------------- Frontend config -----------------
VITE_API_BASE=http://localhost:8000