# PostgreSQL — host must match Docker service name (postgres), not localhost
DATABASE_URL=postgresql+asyncpg://astra:your_password_here@postgres:5432/astra

# Redis — db index 0 is fine unless you add more consumers
REDIS_URL=redis://redis:6379/0

# Free key from https://api.nasa.gov — instant signup, no card needed
NASA_API_KEY=your_nasa_api_key_here

# NOAA public endpoints — don't change unless NOAA updates their URLs
NOAA_BASE_URL=https://services.swpc.noaa.gov
GOES_BASE_URL=https://services.swpc.noaa.gov/json/goes

# ERROR | WARNING | INFO | DEBUG — use INFO in prod, DEBUG locally
LOG_LEVEL=INFO

# development | staging | production
ENVIRONMENT=development