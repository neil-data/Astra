# ASTRA Backend environment config example

# App configurations
APP_NAME=ASTRA
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=development

# Database connections
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://astra_user:astra_pass@localhost:5432/astra_db

# Cache storage connections
REDIS_URL=redis://localhost:6379

# JWT authentication configurations
JWT_SECRET_KEY=change-this-to-a-secure-key-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY=3600
